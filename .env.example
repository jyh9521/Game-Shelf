DATABASE_URL="file:../.data/gameshelf.db"
# 首次初始化用，至少 24 个字符；初始化完成后可移除。
SETUP_TOKEN=
# HTTPS 反向代理时填写完整公网地址；局域网 HTTP 可以留空。
APP_URL=
SECURE_COOKIE=false

# 可选：只填写要使用的来源；这些值只供服务端读取。
# Compose 源码构建时可设置 GAMESHELF_IMAGE=gameshelf:metadata-dev。
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=
THEGAMESDB_API_KEY=
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=
# ScreenScraper 会员用户名和密码可同时留空；如填写，须成对。
SCREENSCRAPER_USERNAME=
SCREENSCRAPER_PASSWORD=
SCREENSCRAPER_SOFTNAME=GameShelf
STEAMGRIDDB_API_KEY=
