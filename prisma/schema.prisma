generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id
  username     String @unique
  passwordHash String
  sessions     Session[]
  items        LibraryItem[]
  profiles     UserGameProfile[]
  imports      BackupImport[]
  gameRelations GameRelation[]
  relationEvents GameRelationEvent[]
}

model Session {
  tokenHash String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model LoginAttempt {
  key String @id
  failures Int @default(0)
  windowStart DateTime
}

model Platform {
  id String @id
  name String @unique
  releases Release[]
}

model Store {
  id String @id
  name String @unique
  items LibraryItem[]
}

model Game {
  id String @id
  title String
  originalTitle String @default("")
  localizedTitle String @default("")
  searchText String
  description String @default("")
  developer String @default("")
  publisher String @default("")
  genre String @default("")
  coverUrl String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  releases Release[]
  profiles UserGameProfile[]
  relationsFrom GameRelation[] @relation("RelationSource")
  relationsTo GameRelation[] @relation("RelationTarget")
  eventsFrom GameRelationEvent[] @relation("EventSource")
  eventsTo GameRelationEvent[] @relation("EventTarget")
  @@index([title])
  @@index([createdAt])
}

model Release {
  id String @id
  gameId String
  platformId String
  region String @default("")
  releaseDate String @default("")
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])
  editions Edition[]
  contents LibraryItemContent[]
  @@index([gameId, platformId])
  @@unique([gameId, platformId, region, releaseDate])
}

model Edition {
  id String @id
  releaseId String
  name String
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  contents LibraryItemContent[]
  @@unique([releaseId, name])
}

model LibraryItem {
  id String @id
  userId String
  storeId String?
  mediaType String
  acquisitionType String
  accessStatus String
  sourceTotalSeconds Int?
  manualTotalOverride Int?
  manualExtraSeconds Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
  contents LibraryItemContent[]
  @@index([userId, createdAt])
}

model LibraryItemContent {
  id String @id
  libraryItemId String
  releaseId String
  editionId String?
  item LibraryItem @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id])
  edition Edition? @relation(fields: [editionId], references: [id])
  @@unique([libraryItemId, releaseId])
}

model UserGameProfile {
  id String @id
  userId String
  gameId String
  status String @default("UNPLAYED")
  rating Int?
  favorite Boolean @default(false)
  memo String @default("")
  overridesJson String @default("{}")
  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  metadata UserGameMetadata?
  @@unique([userId, gameId])
  @@index([userId, status])
}

// Effective values are indexed per user; the shared Game row is not edited
// when a user accepts a candidate or changes a personal value.
model UserGameMetadata {
  profileId String @id
  title String
  originalTitle String
  localizedTitle String
  developer String
  publisher String
  genre String
  description String
  coverUrl String
  searchText String
  updatedAt DateTime
  revision Int @default(0)
  rawgAttributed Boolean @default(false)
  profile UserGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  history ProfileFieldHistory[]
  @@index([genre])
  @@index([title])
  @@index([updatedAt])
}

model ProfileFieldHistory {
  id String @id
  profileId String
  field String
  revision Int
  action String
  previousValue String?
  value String
  locked Boolean
  sourceJson String?
  createdAt DateTime
  metadata UserGameMetadata @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  @@unique([profileId, field, revision])
  @@index([profileId, revision])
}

model BackupImport {
  id String @id
  userId String
  importedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}

// Manual relationship judgments belong to the user, not shared Game metadata.
model GameRelation {
  id String @id
  userId String
  sourceGameId String
  targetGameId String
  type String
  note String
  revision Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Game @relation("RelationSource", fields: [sourceGameId], references: [id], onDelete: Cascade)
  target Game @relation("RelationTarget", fields: [targetGameId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceGameId, targetGameId])
  @@index([userId, targetGameId])
}

// No FK to GameRelation: removing a link must retain its judgment history.
model GameRelationEvent {
  id String @id
  userId String
  relationId String
  sourceGameId String
  targetGameId String
  action String
  type String
  note String
  revision Int
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Game @relation("EventSource", fields: [sourceGameId], references: [id], onDelete: Cascade)
  target Game @relation("EventTarget", fields: [targetGameId], references: [id], onDelete: Cascade)
  @@unique([userId, relationId, revision])
  @@index([userId, sourceGameId, createdAt])
  @@index([userId, targetGameId, createdAt])
}
