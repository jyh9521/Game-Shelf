<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>GameShelf</Name>
  <Repository>jyh9521/gameshelf:0.1.9</Repository>
  <Registry>https://hub.docker.com/r/jyh9521/gameshelf</Registry>
  <Network>bridge</Network>
  <MyIP></MyIP>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support></Support>
  <Project></Project>
  <Overview>个人游戏收藏管理。镜像 jyh9521/gameshelf:0.1.9（Linux/amd64），SteamGridDB 竖版封面可翻页，确认选图后自动收起。沿用平台编辑、资料服务变量、字段历史、作品关系与备份 v3（兼容 v1/v2）。首次初始化凭据位于持久化目录的 setup-token 文件。</Overview>
  <Category>Productivity:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <Icon></Icon>
  <ExtraParams></ExtraParams>
  <PostArgs></PostArgs>
  <Config Name="Web 界面" Target="3000" Default="3000" Mode="tcp" Description="选择未占用的宿主端口" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="数据目录" Target="/data" Default="/mnt/user/appdata/gameshelf" Mode="rw" Description="服务器本地 appdata，不使用远程 SMB/NFS" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/gameshelf</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="实际运行进程的用户 ID；现有数据也须有对应权限" Type="Variable" Display="always" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="实际运行进程的组 ID" Type="Variable" Display="always" Required="true" Mask="false">100</Config>
  <Config Name="访问地址" Target="APP_URL" Default="" Mode="" Description="反向代理时设置浏览器访问的完整地址" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="HTTPS Cookie" Target="SECURE_COOKIE" Default="false" Mode="" Description="HTTPS 代理时设为 true；局域网 HTTP 为 false" Type="Variable" Display="advanced" Required="true" Mask="false">false</Config>
  <Config Name="IGDB Client ID" Target="IGDB_CLIENT_ID" Default="" Mode="" Description="Twitch 应用 Client ID，须与 Client Secret 成对" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="IGDB Client Secret" Target="IGDB_CLIENT_SECRET" Default="" Mode="" Description="Twitch 应用 Client Secret" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="RAWG API Key" Target="RAWG_API_KEY" Default="" Mode="" Description="游戏资料搜索" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="TheGamesDB API Key" Target="THEGAMESDB_API_KEY" Default="" Mode="" Description="游戏资料搜索" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="ScreenScraper 开发者 ID" Target="SCREENSCRAPER_DEV_ID" Default="" Mode="" Description="与开发者密码成对" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="ScreenScraper 开发者密码" Target="SCREENSCRAPER_DEV_PASSWORD" Default="" Mode="" Description="ScreenScraper 核发的开发者凭据" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="ScreenScraper 用户名" Target="SCREENSCRAPER_USERNAME" Default="" Mode="" Description="与会员密码成对，或同时留空" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="ScreenScraper 会员密码" Target="SCREENSCRAPER_PASSWORD" Default="" Mode="" Description="与会员用户名成对" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="ScreenScraper 软件名" Target="SCREENSCRAPER_SOFTNAME" Default="GameShelf" Mode="" Description="如凭据绑定了软件名，填获准的名称" Type="Variable" Display="advanced" Required="false" Mask="false">GameShelf</Config>
  <Config Name="SteamGridDB API Key" Target="STEAMGRIDDB_API_KEY" Default="" Mode="" Description="仅查找竖版封面" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
</Container>


